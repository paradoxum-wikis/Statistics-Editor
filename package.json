{
	"name": "tds-stats-editor",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx vite preview",
		"prepare": "bunx svelte-kit sync || true",
		"check": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"test": "bun test",
		"format": "bunx prettier --write ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bits-ui": "^2.20.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.6",
		"vite-plugin-lucide-preprocess": "^1.13.0"
	},
	"dependencies": {
		"@bhsd/codemirror-wikitext": "^0.12.2",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/sofia-sans-semi-condensed": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"@replit/codemirror-vim": "^6.4.0",
		"codemirror": "^6.0.2",
		"layerchart": "^2.9.2",
		"mediawiki-expr": "^0.2.0",
		"mediawiki-file-url": "^0.4.0",
		"vaul-svelte": "^1.0.0-next.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
