{
	"name": "tds-stats-editor",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx vite preview",
		"prepare": "bunx svelte-kit sync || true",
		"check": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx svelte-kit sync && bunx svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"format": "bunx prettier --write ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"bits-ui": "^2.18.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vite-plugin-lucide-preprocess": "^1.5.4"
	},
	"dependencies": {
		"@bhsd/codemirror-wikitext": "^0.10.1",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@replit/codemirror-vim": "^6.4.0",
		"codemirror": "^6.0.2",
		"layerchart": "^2.2.0",
		"mediawiki-expr": "^0.0.2",
		"mediawiki-file-url": "^0.4.0",
		"vaul-svelte": "^1.0.0-next.7"
	}
}
